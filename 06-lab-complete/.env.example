# Copy: cp .env.example .env  (file .env đã nằm trong .gitignore — không commit)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret: đặt giá trị riêng của bạn, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(24))"
AGENT_API_KEY=

# Khi chạy bằng docker compose, REDIS_URL được compose ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
